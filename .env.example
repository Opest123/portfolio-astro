# Copy to .env and fill in. Without RESEND_API_KEY the contact form still works
# locally, it just logs the email to the terminal instead of sending it.
RESEND_API_KEY=
# Must be on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email)
EMAIL_FROM="Stephen Enikanoselu <hello@stephenenikanoselu.com>"
CONTACT_TO_EMAIL=stephenenikanoselu@gmail.com
