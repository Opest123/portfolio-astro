---
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import { projects } from '../../data/projects';
---

<section id="projects" class="px-4 py-20 md:px-6 md:py-28">
    <div class="mx-auto max-w-6xl">
        <SectionHeading eyebrow="Selected Work" title="Things I've built 🚀" />

        <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => (
                <a
                    href={project.url}
                    target="_blank"
                    rel="noopener"
                    class="nb-card nb-card-hover reveal group flex flex-col overflow-hidden"
                >
                    <div class:list={[project.bg, 'border-b-[3px] border-ink p-4']}>
                        <Image
                            src={project.image}
                            alt={`${project.name} screenshot`}
                            width={800}
                            height={600}
                            class="aspect-[4/3] w-full border-[3px] border-ink bg-white object-cover object-top"
                        />
                    </div>
                    <div class="flex flex-1 flex-col p-5">
                        <h3 class="text-xl uppercase leading-tight">{project.name}</h3>
                        <p class="mt-3 font-grotesk text-sm text-ink/70">{project.blurb}</p>
                        <p class="mt-3 flex-1 font-grotesk text-xs font-bold uppercase tracking-wide text-ink/50">
                            {project.stack.join(' · ')}
                        </p>
                        <span class="mt-5 inline-flex items-center gap-2 font-display text-sm uppercase tracking-wide text-grape group-hover:underline">
                            Visit site ↗
                        </span>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>
