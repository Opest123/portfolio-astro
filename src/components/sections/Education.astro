---
import SectionHeading from '../SectionHeading.astro';
import { education } from '../../data/skills';
---

<section id="education" class="px-4 py-20 md:px-6 md:py-28">
    <div class="mx-auto max-w-5xl">
        <SectionHeading eyebrow="Education" title="Where I studied 🎓" tilt="right" />

        <div class="mt-10 grid gap-8 md:grid-cols-2">
            {education.map((item) => (
                <div class="nb-card nb-card-hover reveal p-7 md:p-8">
                    <span class:list={['nb-tag', item.tag]}>{item.years}</span>
                    <h3 class="mt-5 text-2xl uppercase md:text-3xl">{item.school}</h3>
                    <p class="mt-3 font-grotesk text-lg text-ink/80">{item.detail}</p>
                </div>
            ))}
        </div>
    </div>
</section>
