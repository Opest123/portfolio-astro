---
interface Props {
    eyebrow: string;
    title: string;
    /** Tilt of the eyebrow sticker, alternates between sections */
    tilt?: 'left' | 'right';
}

const { eyebrow, title, tilt = 'left' } = Astro.props;
---

<div class="reveal">
    <span class:list={['nb-eyebrow', tilt === 'left' ? 'rotate-[-2deg]' : 'rotate-[2deg]']}>{eyebrow}</span>
    <h2 class="mt-6 text-3xl uppercase md:text-5xl">{title}</h2>
    <slot />
</div>
